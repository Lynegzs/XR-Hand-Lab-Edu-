# Groq API (Ultra-rápido: Llama 3.3 / GPT-OSS / Qwen)
GROQ_API_KEY=

GEMINI_API_KEY=

# Proveedor de generación de imágenes (Opcional - auto usará Cloudflare -> Gemini -> Pollinations gratis)
IMAGE_PROVIDER=auto

# Calidad de generación de imágenes (balanced | high | fast)
IMAGE_QUALITY=balanced

# Límite diario de imágenes por IP para protección escolar (default: 80)
IMAGE_DAILY_LIMIT=80

# Cloudflare Workers AI (Opcional - para FLUX-1-Schnell / SDXL-Lightning)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
